# Optional: copy to .env to override the defaults in docker-compose.yml
POSTGRES_USER=stepping
POSTGRES_PASSWORD=stepping
POSTGRES_DB=stepping_stones

# Host port for Postgres. Change it if 5432 is already in use.
# POSTGRES_PORT=5430

# Host port for the backend API. Change it if 8000 is already in use.
# BACKEND_PORT=8001

# Frontend: true = screens get example answers instead of calling the API.
# VITE_SAMPLE_DATA=true
# Frontend: name and role shown at the bottom of the left menu ("Agent" if unset).
# VITE_AGENT_NAME=Robert
# VITE_AGENT_ROLE=Agent
